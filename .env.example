# =============================================================================
# n8n-hubspot-portal-configuration-snapshot-git-backup :: environment template
# -----------------------------------------------------------------------------
# Copy to .env (git-ignored) or set these in your n8n host / container / secret
# manager. Every value below is a PLACEHOLDER. Never commit real values.
#
# SAFE BY DEFAULT: leaving this file untouched keeps the workflow in
# SANDBOX_MODE with DRY_RUN on and Git commits / notifications off.
# =============================================================================

# ---- n8n runtime (required for this workflow to read env vars) ---------------
# Allows {{ $env.X }} in expressions and Code nodes. Recent n8n releases block it
# by default; if it stays blocked the workflow falls back to sandbox defaults.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Optional: lets the checksum node use Node's native crypto (a bundled pure-JS
# SHA-256 with identical output is used otherwise).
NODE_FUNCTION_ALLOW_BUILTIN=crypto
# Time zone used by the Schedule Trigger.
GENERIC_TIMEZONE=UTC

# ---- Safety switches (safe defaults shown) ----------------------------------
# Safe-ON flags turn off only on an explicit false/0/no/off.
SANDBOX_MODE=true
DRY_RUN=true
# Safe-OFF flags turn on only on an explicit true/1/yes/on.
GIT_COMMITS_ENABLED=false
NOTIFICATIONS_ENABLED=false

# ---- HubSpot (live mode only) -----------------------------------------------
# Private app access token with READ scopes only (see README "Required scopes").
HUBSPOT_ACCESS_TOKEN=
# Numeric portal (Hub) ID. 99000001 is the synthetic sandbox placeholder.
HUBSPOT_PORTAL_ID=99000001
HUBSPOT_API_BASE_URL=https://api.hubapi.com
# v4 = /automation/v4/flows (all object types). v3 = contact-based workflows only.
HUBSPOT_WORKFLOWS_API=v4
# Cross-checks the token's portal against HUBSPOT_PORTAL_ID before exporting.
VERIFY_PORTAL_ID=true

# ---- Export scope -----------------------------------------------------------
EXPORT_CUSTOM_OBJECTS=true
EXPORT_PROPERTIES=true
EXPORT_PROPERTY_GROUPS=true
EXPORT_PIPELINES=true
EXPORT_WORKFLOWS=true
EXPORT_OBJECT_TYPES=contacts,companies,deals,tickets
EXPORT_PIPELINE_OBJECT_TYPES=deals,tickets
# false = back up only custom (portal-defined) properties.
EXPORT_HUBSPOT_DEFINED_PROPERTIES=false

# ---- Normalization ----------------------------------------------------------
STRIP_VOLATILE_TIMESTAMPS=true
REDACT_USER_IDS=true

# ---- Git target (GitHub REST API) -------------------------------------------
# Fine-grained PAT limited to ONE private repo with "Contents: Read and write".
GITHUB_PAT=
# owner/repo form, NOT a URL.
GITHUB_REPOSITORY=example-org/hubspot-config-backup
# Human-facing repo URL, used only for links in the summary.
GIT_REPO_URL=https://github.example/example-org/hubspot-config-backup.git
GITHUB_API_BASE_URL=https://api.github.com
# Dedicated branch; must exist before the first live commit.
GIT_BRANCH=hubspot-config-snapshots
GIT_PROTECTED_BRANCHES=main,master,production
GIT_ALLOW_PROTECTED_BRANCH=false
GIT_SNAPSHOT_ROOT=snapshots
GIT_REMOTE_DIFF_ENABLED=true
GIT_PRUNE_REMOVED_FILES=false
GIT_COMMIT_ON_DEGRADED=false
GIT_COMMIT_AUTHOR_NAME=HubSpot Config Snapshot Bot
GIT_COMMIT_AUTHOR_EMAIL=snapshot-bot@example.invalid
COMMIT_MESSAGE_MAX_RECORD_NAMES=15

# ---- Notifications ----------------------------------------------------------
# Slack incoming webhook (or any endpoint accepting {"text","blocks"} JSON).
SLACK_WEBHOOK_URL=
NOTIFY_CHANNEL_LABEL=#revops-alerts

# ---- Testing ----------------------------------------------------------------
# Pins the snapshot timestamp (ISO 8601) for reproducible test runs.
SNAPSHOT_TIMESTAMP_OVERRIDE=

